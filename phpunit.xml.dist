<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="MOLONI_CLIENT_ID" value="(null)" force="true"/>
        <env name="MOLONI_CLIENT_SECRET" value="(null)" force="true"/>
        <env name="MOLONI_EMAIL" value="(null)" force="true"/>
        <env name="MOLONI_PASSWORD" value="(null)" force="true"/>
        <env name="MOLONI_PREFIX" value="(null)" force="true"/>
        <env name="MOLONI_BASE_URL" value="https://api.moloni.pt/v1/" force="true"/>
        <env name="MOLONI_TIMEOUT" value="15" force="true"/>
        <env name="MOLONI_CONNECT_TIMEOUT" value="5" force="true"/>
        <env name="MOLONI_QUEUE_CONNECTION" value="database" force="true"/>
        <server name="MOLONI_CLIENT_ID" value="(null)"/>
        <server name="MOLONI_CLIENT_SECRET" value="(null)"/>
        <server name="MOLONI_EMAIL" value="(null)"/>
        <server name="MOLONI_PASSWORD" value="(null)"/>
        <server name="MOLONI_PREFIX" value="(null)"/>
        <server name="MOLONI_BASE_URL" value="https://api.moloni.pt/v1/"/>
        <server name="MOLONI_TIMEOUT" value="15"/>
        <server name="MOLONI_CONNECT_TIMEOUT" value="5"/>
        <server name="MOLONI_QUEUE_CONNECTION" value="database"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
