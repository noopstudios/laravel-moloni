# Credentials and targets for the sandbox suite (tests/Integration/SandboxTest.php):
#   MOLONI_SANDBOX_ENV=/path/to/.env.sandbox vendor/bin/pest --group=sandbox
# Copy to .env.sandbox (git-ignored) or point MOLONI_SANDBOX_ENV at a file outside the repository.
# Every run issues real documents: use a Moloni company and a document set kept for tests only,
# never Moloni's shared demo company (5), never a series that holds future-dated documents.

MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_EMAIL=
MOLONI_PASSWORD=

# The test company and the document set (series) every document is issued in.
MOLONI_SANDBOX_COMPANY_ID=
MOLONI_SANDBOX_DOCUMENT_SET_ID=
